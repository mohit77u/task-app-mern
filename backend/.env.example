NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (secret - set it only in your local .env or the host's env settings)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/
MONGODB_DB=taskmanager_dev

JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=365

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
THROTTLING_ENABLED=true

# Read only by the seed script
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
